{
  "$schema": "https://opencode.ai/config.json",

  // MCP servers. Playwright and Chrome DevTools are used for UI tests and debugging.
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },
  },

  // Permissions: the LAST matching rule wins. Specific exceptions go after broad rules.
  "permission": {
    "bash": {
      "*": "ask",
      // Routine read-only / dev commands run without prompting.
      "make *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      // Package manager installs require confirmation.
      "brew *": "ask",
      // Git mutations require confirmation (see AGENTS.md workflow).
      "git commit *": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "rm *": "ask",
      // Always blocked.
      "sudo *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
    },
    // Do not touch secrets and the Hexlet check workflow (see AGENTS.md).
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
    },
    "edit": {
      ".github/workflows/hexlet-check.yml": "deny",
    },
  },
}
